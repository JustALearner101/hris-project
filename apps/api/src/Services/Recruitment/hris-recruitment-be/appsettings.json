{
  "ConnectionStrings": {
    "DefaultConnection": ""
  },
  "Redis": {
    "ConnectionString": "localhost:6379"
  },
  "Storage": {
    "CvRootPath": "/cv-data"
  },
  "Auth": {
    "Authority": "http://localhost:8081/realms/hris",
    "Audience": "recruitment-api",
    "RequireHttpsMetadata": false,
    "Issuer": "hris-ats-auth",
    "SigningKey": "hris-ats-development-signing-key-at-least-32-bytes-long!"
  },
  "Retention": {
    "RejectedCandidateRetentionDays": 365
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
