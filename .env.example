# Monorepo Root Environment Variables Example
# Duplicate file ini menjadi .env untuk konfigurasi lokal

# Frontend Configuration
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080/api/v1
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-super-secret-key-change-in-production

# Backend ASP.NET Core Configuration
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://+:8080

# Database Configuration (PostgreSQL)
POSTGRES_USER=hris
POSTGRES_PASSWORD=hris
POSTGRES_DB=hris
DATABASE_URL=Host=localhost;Port=5432;Database=hris;Username=hris;Password=hris

# Redis Configuration
REDIS_URL=localhost:6379

# Keycloak SSO Configuration
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
KEYCLOAK_URL=http://localhost:8081
