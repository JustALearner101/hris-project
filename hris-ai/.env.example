# ==============================================================================
# IOH-RAG-POC Environment Configuration Template
# Copy this file to .env and populate your credentials.
# NEVER commit your actual .env file to version control.
# ==============================================================================

# --- Application & Logging ---
APP_ENV=development
LOG_LEVEL=INFO

# --- Local Storage & Vector Database ---
DATA_DIR=./data
VECTOR_DB_TYPE=chroma
VECTOR_DB_DIR=./data/vector_store

# --- Embedding Model (100% Local Inference via PyTorch) ---
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=BAAI/bge-m3
MODEL_CACHE_DIR=./data/cache/models

# Set to 1 to run 100% offline (prevents checking/connecting to Hugging Face):
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1

# --- Generation & LLM Provider (Sumopod / OpenAI / Anthropic Plug-and-Play) ---
# Primary configuration (unified):
LLM_PROVIDER=openai
LLM_BASE_URL=https://ai.sumopod.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
# Supported SumoPod models: gpt-4o-mini, gpt-4o, claude-3-haiku, deepseek-chat
LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=1024

# Provider-specific fallbacks (optional):
# OPENAI_API_KEY=
# OPENAI_BASE_URL=
# ANTHROPIC_API_KEY=
# ANTHROPIC_BASE_URL=

