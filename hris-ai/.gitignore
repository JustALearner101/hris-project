# ==============================================================================
# Version Control Exclusion Rules: IOH-RAG-POC
# ==============================================================================

# --- Environment & Credentials ---
.env
.env.local
.env.*.local
!.env.example

# --- Python Bytecode & Cache ---
__pycache__/
*.py[cod]
*$py.class
*.so

# --- Virtual Environments ---
.venv/
venv/
ENV/
env/

# --- Testing & Coverage ---
.pytest_cache/
.coverage
htmlcov/
.tox/

# --- Local Data & Vector Storage ---
data/*
!data/.gitignore
!data/raw/.gitkeep
!data/processed/.gitkeep
!data/vector_store/.gitkeep
!data/cache/.gitkeep

# --- Database & Cache Files ---
*.db
*.sqlite
*.sqlite3

# --- Build & Distribution ---
build/
dist/
*.egg-info/
*.egg

# --- Operating System & Editor Metadata ---
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo

# --- Node.js & Next.js Frontend ---
node_modules/
.next/
out/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

